#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Install: (this repository: git config core.hooksPath .githooks)
# Blocks a push whose new commits carry a personal email, a home path, an account id, a token, or media metadata.
GATE="$(git rev-parse --show-toplevel)/scripts/lampway/prepublish_gate.py"
# the owner-specific patterns live OUTSIDE the repository: a local file (mode 0600, never printed) of PII_OWNER_*_RE variables, in the shared git dir
for d in "$(git rev-parse --git-common-dir)" "$(git rev-parse --git-dir)"; do
  if [ -f "$d/pii_owner.env" ]; then set -a; . "$d/pii_owner.env"; set +a; break; fi
done
zero=0000000000000000000000000000000000000000
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                      # a deletion
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  python3 "$GATE" --git "$range" || { echo "pre-push: blocked by the pre-publish gate (see above). Fix, or amend the commits." >&2; exit 1; }
done
# media shipped in the tree (site folders, docs images)
for d in docs; do [ -d "$d" ] && { python3 "$GATE" --media "$d" || exit 1; }; done
# the agent rail, quick form: the tree's shape plus the commits no remote holds yet (CI runs the full check: history, worktree,
# generated docs). A branch without the rail has no rail/rail.py and skips this.
RAIL="$(git rev-parse --show-toplevel)/rail/rail.py"
if [ -f "$RAIL" ]; then
  python3 "$RAIL" check --quick || { echo "pre-push: blocked by the rail (see above; docs/rail.md says how to repair each code)." >&2; exit 1; }
fi
exit 0
