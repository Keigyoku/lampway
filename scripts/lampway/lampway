#
# lampway: the one command. Starts our server on localhost, starts Lampway pointed at it with the tools and the live bridge
# enabled, opens a given .blend, and stops the server it started when the app exits.
#
#   lampway [--env Dev|Prod] [--copy] [--provider mock|anthropic|openai|openrouter|chatgpt_plan|codex_cli|claude_cli]
#           [--openrouter-key-file F] [--budget USD] [--image-backend tripo|codex_cli|openrouter]
#           [--port 8787] [--bridge-port 9876] [--no-server] [--system-keyring] [--plan] [file.blend]
#
# OpenRouter: the key is never an argument and never printed. Give it as OPENROUTER_API_KEY in the environment, or point
# --openrouter-key-file at a file holding OPENROUTER_API_KEY=... (a dotenv file). --budget is the session spend ceiling in USD
# (default 3): every request carries a token cap, and past the ceiling every OpenRouter call is refused. Each launch starts a
# fresh spend log (the old one is kept as openrouter_spend.jsonl.prev).
#   lampway --install-desktop | --uninstall-desktop      the app-menu entry (lampway.desktop); it runs this same command
#
# UE Look: while it is enabled (<home>/ue_look/launch.state, written by the app's UE Look toggle) and its cube still validates
# (the generated OCIO config exists and the cube's sha256 is the one recorded), the app starts with OCIO=<that config>, so the UE
# view exists; otherwise OCIO is left exactly as it was. The state file is read as key=value lines, never sourced.
# --copy opens a COPY of the .blend (under <home>/copies); your file is never opened for saving.
# The app runs through scripts/unix/run.sh, which owns the Wayland/X11 switch (LAMPWAY_LINUX_BACKEND=auto|x11).
# Profile: everything lives under $LAMPWAY_HOME (default ~/.local/share/lampway): an isolated config/data profile (your stock
# Blender/Mixar profile is not touched), the server's state, projects/, the bridge directory, the file keyring.
# Refusals go to stdout and exit 1; an unknown flag exits 2.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
HOME_DIR="${LAMPWAY_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/lampway}"
# Secrets live OUTSIDE the Lampway home, which the agent's script sandbox can reach (Connections, decision C7): the client's login pair
# and the server's Connections store. An older $HOME_DIR/keyring.json is moved there once, verified before the original goes.
STATE_BASE="${XDG_STATE_HOME:-$HOME/.local/state}"
KEYRING_FILE="${LAMPWAY_KEYRING_FILE:-$STATE_BASE/lampway/keyring.json}"
SECRETS_DIR="${LAMPWAY_SECRETS_DIR:-$STATE_BASE/lampway-secrets}"

BUILD_ENV=""; COPY=0; PROVIDER="${LAMPWAY_PROVIDER:-mock}"; PORT="${LAMPWAY_SERVER_PORT:-8787}"; BRIDGE_PORT="${LAMPWAY_BRIDGE_PORT:-9876}"
NO_SERVER=0; SYSTEM_KEYRING=0; PLAN=0; ACTION=run; BLEND=""
KEY_FILE="${LAMPWAY_OPENROUTER_KEY_FILE:-}"; BUDGET="${LAMPWAY_OPENROUTER_BUDGET_USD:-3}"; IMAGE_BACKEND="${LAMPWAY_IMAGE_BACKEND:-}"
refuse() { echo "error: $1"; shift; if [ $# -gt 0 ]; then echo "help[$#]:"; for h in "$@"; do echo "  - $h"; done; fi; exit 1; }
while [ $# -gt 0 ]; do
  case "$1" in
    --env) BUILD_ENV="${2:?--env needs Dev or Prod}"; shift 2 ;;
    --copy) COPY=1; shift ;;
    --provider) PROVIDER="${2:?--provider needs a name}"; shift 2 ;;
    --port) PORT="${2:?--port needs a number}"; shift 2 ;;
    --bridge-port) BRIDGE_PORT="${2:?--bridge-port needs a number (0 = off)}"; shift 2 ;;
    --openrouter-key-file) KEY_FILE="${2:?--openrouter-key-file needs a path}"; shift 2 ;;
    --budget) BUDGET="${2:?--budget needs a number of USD}"; shift 2 ;;
    --image-backend) IMAGE_BACKEND="${2:?--image-backend needs tripo, codex_cli or openrouter}"; shift 2 ;;
    --no-server) NO_SERVER=1; shift ;;
    --system-keyring) SYSTEM_KEYRING=1; shift ;;
    --plan) PLAN=1; shift ;;
    --install-desktop) ACTION=install; shift ;;
    --uninstall-desktop) ACTION=uninstall; shift ;;
    --*) echo "unknown flag: $1" >&2; exit 2 ;;
    *) BLEND="$1"; shift ;;
  esac
done

if [ -z "$BUILD_ENV" ]; then
  if [ -x "$ROOT/build/Prod/bin/mixar" ]; then BUILD_ENV=Prod; else BUILD_ENV=Dev; fi
fi
BINARY="$ROOT/build/$BUILD_ENV/bin/mixar"
SERVER_URL="http://127.0.0.1:$PORT"
# the Asset Vault's embedding weights, bundled by build_linux.sh into the install (never fetched at runtime)
MODELS_DIR="$ROOT/build/$BUILD_ENV/bin/5.2/datafiles/lampway/models"

if [ "$ACTION" = uninstall ]; then exec "$ROOT/scripts/unix/install_desktop_entry.sh" --uninstall; fi
if [ "$ACTION" = install ]; then
  [ -x "$BINARY" ] || refuse "no build at $BINARY" "Run \`scripts/lampway/build_linux.sh\` first"
  exec "$ROOT/scripts/unix/install_desktop_entry.sh" "$BUILD_ENV"
fi

# UE Look state: UE_LOOK is off | on | invalid; UE_OCIO the config to export when on
UE_LOOK=off; UE_OCIO=""
UE_STATE="$HOME_DIR/ue_look/launch.state"
if [ -f "$UE_STATE" ]; then
  ue_cfg=""; ue_cube=""; ue_sha=""
  while IFS='=' read -r key value; do
    case "$key" in config) ue_cfg="$value" ;; cube) ue_cube="$value" ;; cube_sha256) ue_sha="$value" ;; esac
  done < "$UE_STATE"
  UE_LOOK=invalid
  if [ -n "$ue_cfg" ] && [ -f "$ue_cfg" ] && [ -n "$ue_cube" ] && [ -f "$ue_cube" ] && [ -n "$ue_sha" ] \
     && [ "$(sha256sum < "$ue_cube" | cut -d' ' -f1)" = "$ue_sha" ]; then
    UE_LOOK=on; UE_OCIO="$ue_cfg"
  fi
fi

if [ "$PLAN" = 1 ]; then
  echo "bin: $0"; echo "description: Starts the Lampway server and the app on localhost; opens a .blend (a copy with --copy)"
  echo "server_url: $SERVER_URL"; echo "build_env: $BUILD_ENV"; echo "binary: $BINARY"; echo "bridge_port: $BRIDGE_PORT"
  echo "provider: $PROVIDER"
  if [ "$PROVIDER" = openrouter ] || [ "$IMAGE_BACKEND" = openrouter ]; then
    echo "main_model: ${LAMPWAY_OPENROUTER_MODEL:-anthropic/claude-sonnet-5.5}"; echo "swarm_model: ${LAMPWAY_OPENROUTER_SWARM_MODEL:-deepseek/deepseek-v4.1-flash}"
    echo "image_model: ${LAMPWAY_OPENROUTER_IMAGE_MODEL:-google/gemini-3.1-flash-image}"; echo "budget_usd: $BUDGET"
    echo "key_file: ${KEY_FILE:-none (OPENROUTER_API_KEY from the environment: $([ -n "${OPENROUTER_API_KEY:-}" ] && echo set || echo not set))}"
  fi
  echo "models: $MODELS_DIR $([ -d "$MODELS_DIR" ] && echo '(bundled)' || echo '(absent: the Vault offers the one-click fetch)')"
  echo "ue_look: $UE_LOOK${UE_OCIO:+ (OCIO=$UE_OCIO)}"
  echo "home: $HOME_DIR"; echo "keyring: $([ $SYSTEM_KEYRING = 1 ] && echo system || echo file)"
  echo "keyring_file: $KEYRING_FILE"; echo "secrets_dir: $SECRETS_DIR"
  echo "server: $([ $NO_SERVER = 1 ] && echo none || echo started-and-stopped-by-this-command)"; echo "blend: ${BLEND:-none}${BLEND:+ $([ $COPY = 1 ] && echo '(copy)' || echo '(opened directly)')}"
  exit 0
fi

[ -x "$BINARY" ] || refuse "no build at $BINARY" "Run \`scripts/lampway/build_linux.sh\` first (MIXAR_ENV=$BUILD_ENV)"
if [ -n "$BLEND" ] && [ ! -f "$BLEND" ]; then refuse "$BLEND not found"; fi

if [ "$PROVIDER" = openrouter ] || [ "$IMAGE_BACKEND" = openrouter ]; then
  if [ -z "${OPENROUTER_API_KEY:-}" ] && { [ -z "$KEY_FILE" ] || [ ! -r "$KEY_FILE" ]; }; then
    refuse "no OpenRouter key" "Set OPENROUTER_API_KEY in the environment, or pass --openrouter-key-file <a file holding OPENROUTER_API_KEY=...>"
  fi
fi
mkdir -p "$HOME_DIR"/{config,data,bridge,projects,server-state,copies}
chmod 700 "$HOME_DIR" 2>/dev/null || true
if [ -n "$BLEND" ] && [ "$COPY" = 1 ]; then
  name="$(basename "$BLEND" .blend)"; stamp="$(date +%Y%m%d-%H%M%S)"
  cp -- "$BLEND" "$HOME_DIR/copies/$name-$stamp.blend" && BLEND="$HOME_DIR/copies/$name-$stamp.blend"
fi

SPEND_LOG="$HOME_DIR/server-state/openrouter_spend.jsonl"
if [ "$PROVIDER" = openrouter ] || [ "$IMAGE_BACKEND" = openrouter ]; then
  [ -f "$SPEND_LOG" ] && mv -f "$SPEND_LOG" "$SPEND_LOG.prev"          # a session starts with an empty ledger
  export LAMPWAY_OPENROUTER_BUDGET_USD="$BUDGET" LAMPWAY_SPEND_LOG="$SPEND_LOG"
  [ -n "$KEY_FILE" ] && export LAMPWAY_OPENROUTER_KEY_FILE="$KEY_FILE"
fi
[ -n "$IMAGE_BACKEND" ] && export LAMPWAY_IMAGE_BACKEND="$IMAGE_BACKEND"
port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
SERVER_PID=""
stop_server() { if [ -n "$SERVER_PID" ] && kill -0 "$SERVER_PID" 2>/dev/null; then kill "$SERVER_PID" 2>/dev/null; wait "$SERVER_PID" 2>/dev/null; fi; }
trap stop_server EXIT INT TERM

if [ "$NO_SERVER" = 0 ]; then
  if port_open "$PORT"; then
    if command -v curl >/dev/null 2>&1 && curl -s -m 3 "$SERVER_URL/api/v1/auth/me" 2>/dev/null | grep -q '"detail"'; then
      echo "a Lampway server already answers on $SERVER_URL: using it"
    else
      refuse "port $PORT is in use by something that is not a Lampway server" "Pick another port: \`lampway --port <n>\`"
    fi
  else
    if [ -n "${LAMPWAY_SERVER_CMD:-}" ]; then SERVER_CMD="$LAMPWAY_SERVER_CMD"
    else
      PY="${LAMPWAY_SERVER_PYTHON:-}"; [ -z "$PY" ] && [ -x "$ROOT/server/.venv/bin/python" ] && PY="$ROOT/server/.venv/bin/python"; PY="${PY:-python3}"
      SERVER_CMD="$PY -m lampway_server"
    fi
    [ -d "$MODELS_DIR" ] && export LAMPWAY_MODELS_DIR="$MODELS_DIR"
    LAMPWAY_HOST=127.0.0.1 LAMPWAY_PORT="$PORT" LAMPWAY_PROVIDER="$PROVIDER" LAMPWAY_STATE_DIR="$HOME_DIR/server-state" LAMPWAY_SECRETS_DIR="$SECRETS_DIR" LAMPWAY_BLENDER="${LAMPWAY_BLENDER:-$BINARY}" \
      LAMPWAY_PROJECT_ROOT="$HOME_DIR/projects" PYTHONPATH="$ROOT/server${PYTHONPATH:+:$PYTHONPATH}" \
      $SERVER_CMD > "$HOME_DIR/server.log" 2>&1 &
    SERVER_PID=$!
    echo "$SERVER_PID" > "$HOME_DIR/server.pid"
    if [ "${LAMPWAY_SKIP_SERVER_WAIT:-0}" != 1 ]; then
      for _ in $(seq 1 100); do port_open "$PORT" && break; kill -0 "$SERVER_PID" 2>/dev/null || refuse "the server exited at start-up; see $HOME_DIR/server.log"; sleep 0.2; done
      port_open "$PORT" || refuse "the server did not open port $PORT; see $HOME_DIR/server.log"
    fi
  fi
fi

export XDG_CONFIG_HOME="$HOME_DIR/config" XDG_DATA_HOME="$HOME_DIR/data"
export LAMPWAY_HOME="$HOME_DIR" LAMPWAY_BACKEND_URL="$SERVER_URL" LAMPWAY_BRIDGE_PORT="$BRIDGE_PORT" LAMPWAY_BRIDGE_DIR="$HOME_DIR/bridge"
export LAMPWAY_PROJECT_ROOT="$HOME_DIR/projects" LAMPWAY_SERVER_PID_FILE="$HOME_DIR/server.pid"
# the mesh-paint image backend (lampway_server.imagegen) runs in the server's python, launched by the app's tools
[ -n "${LAMPWAY_SERVER_PYTHON:-}" ] && export LAMPWAY_PYTHON_SERVER="$LAMPWAY_SERVER_PYTHON"
[ -d "$ROOT/server" ] && export LAMPWAY_SERVER_DIR="$ROOT/server"
move_keyring_once() {
  local old="$HOME_DIR/keyring.json" new="$KEYRING_FILE" dir tmp
  [ -f "$old" ] || return 0
  [ -e "$new" ] && return 0                                       # never overwrite: the new place already holds a pair
  dir="$(dirname "$new")"; [ -d "$dir" ] || mkdir -p -m 700 "$dir" || return 0
  tmp="$new.moving.$$"
  if cp -- "$old" "$tmp" && chmod 600 "$tmp" && sync "$tmp" 2>/dev/null; cmp -s "$old" "$tmp" && mv -f -- "$tmp" "$new"; then
    rm -f -- "$old"
    mkdir -p "$HOME_DIR/server-state/connections"
    printf '{"action": "moved", "by": "system", "id": "lampway_server", "ok": true, "reason": "keyring.json moved out of the agent sandbox to %s", "t": %s}\n' \
      "$new" "$(date +%s)" >> "$HOME_DIR/server-state/connections/log.jsonl"
    echo "note: the login keyring moved out of the agent's reach: $new"
  else
    rm -f -- "$tmp"; echo "note: the login keyring could not be moved to $new; it stays at $old"
  fi
}
if [ "$SYSTEM_KEYRING" = 0 ]; then
  move_keyring_once
  export PYTHON_KEYRING_BACKEND="mixar.modules.lampway_tools.keyring_file.FileKeyring" LAMPWAY_KEYRING_FILE="$KEYRING_FILE"
fi
if [ "$UE_LOOK" = on ]; then
  export OCIO="$UE_OCIO"; echo "UE Look: OCIO=$UE_OCIO"
elif [ "$UE_LOOK" = invalid ]; then
  echo "UE Look is on but its cube does not validate (missing, moved or changed since it was enabled): OCIO left as it was; point UE Look at the cube again"
fi
# the app: through run.sh (it owns LAMPWAY_LINUX_BACKEND); not exec'd, so this shell can stop the server it started
"$ROOT/scripts/unix/run.sh" "$BUILD_ENV" ${BLEND:+"$BLEND"}
RC=$?
exit $RC
