{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Keigyoku/lampway/prompt_template.schema.json",
  "title": "Lampway prompt template",
  "description": "One image or video prompt: the five-part spine Subject, Action, Camera, Style, Constraints with {{variable}} slots, typed variables, at most 5 negatives, optional timed beats, the media roles it expects, per-model adapters, the gates that judge its output and where its wording came from. Variables in body parts, beats and adapters are written {{name}}; a media role is referenced as [role] (e.g. [start_image]) and rewritten per model.",
  "type": "object",
  "required": [
    "id",
    "version",
    "purpose",
    "media",
    "title",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "semver; a changed wording is a NEW version"
    },
    "purpose": {
      "enum": [
        "anim-walk",
        "anim-loop",
        "anim-motion-transfer",
        "anim-split",
        "articulation",
        "plate",
        "albedo",
        "material-id",
        "concept",
        "tile",
        "character-reference",
        "anim-start-frame",
        "texture-plate",
        "character-sheet",
        "character-part",
        "turntable",
        "motion-graphics"
      ]
    },
    "media": {
      "enum": [
        "image",
        "video"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "body": {
      "type": "object",
      "required": [
        "subject",
        "action",
        "camera",
        "style",
        "constraints"
      ],
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "camera": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "constraints": {
          "type": "string"
        }
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "enum"
            ]
          },
          "default": {},
          "enum": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "negatives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "description": "pick the 3-5 that matter"
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t0",
          "t1",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "t0": {
            "type": "number",
            "minimum": 0
          },
          "t1": {
            "type": "number"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "start_image",
          "end_image",
          "image_references",
          "video_reference",
          "clay_render",
          "painted_view",
          "design_plate",
          "reference_image",
          "character_body",
          "piece_images"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "required": {
            "type": "boolean"
          },
          "multiple": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "description": "the position this reference must have among the images sent: the prompt names them first, second, third and the order is enforced"
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "aspect_ratio": {
          "type": "string"
        },
        "duration": {
          "type": "integer"
        },
        "generate_audio": {
          "type": "boolean"
        },
        "image_mode": {
          "enum": [
            "first_frame",
            "first_last_frame",
            "reference"
          ]
        },
        "size": {
          "type": "string"
        },
        "quality": {
          "type": "string"
        },
        "background": {
          "enum": [
            "opaque",
            "transparent"
          ]
        },
        "resolution_class": {
          "type": "string"
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "model_adapters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref_names": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "max_words": {
            "type": "integer",
            "minimum": 1
          },
          "replace": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "drop_phrases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "threshold": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "root_motion": {
      "enum": [
        "none",
        "tracked"
      ],
      "description": "does the clip carry travel (tracked) or walk in place (none)"
    },
    "variant_of": {
      "type": "string",
      "description": "id@version this is an A/B variant of"
    },
    "pin": {
      "type": "boolean",
      "description": "CH5: true keeps defaults.model over the purpose's choice; needs pin_reason"
    },
    "pin_reason": {
      "type": "string",
      "maxLength": 300,
      "description": "why this template must run its own model"
    }
  }
}
