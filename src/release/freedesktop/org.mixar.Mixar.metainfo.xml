<!-- LAMPWAY: user-facing identity of the fork. The component id and the
     desktop file name stay as upstream named them so installs upgrade in
     place; the URLs are built on the PLACEHOLDER website (see
     src/scripts/mixar/config/brand.py, WEBSITE_URL). -->
<component type="desktop">
    <id>com.mixar.mixar</id>
    <launchable type="desktop-id">mixar.desktop</launchable>
    <name>Lampway</name>
    <summary>AI-assisted 3D content creation, a fork of the GPL Mixar client</summary>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>
    <description>
        <p>
            Lampway is a fork of the GPL Mixar client, itself built on
            Blender. It runs against your own Lampway server and supports
            the entirety of the 3D pipeline: modeling, rigging, animation,
            simulation, rendering, compositing, motion tracking and video
            editing. Lampway is not affiliated with Mixar.
        </p>
    </description>
    <url type="homepage">https://lampway.app</url>
    <url type="bugtracker">https://github.com/Keigyoku/lampway/issues</url>
    <url type="help">https://lampway.app/docs</url>
    <url type="vcs-browser">https://github.com/Keigyoku/lampway</url>
    <content_rating type="oars-1.1" />
</component>
